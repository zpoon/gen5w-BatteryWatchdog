[nemesis]
version=1.1
id=battery.watchdog
name=Battery Watchdog
type=application,service
package-version=0.0.0
short-desc=Monitors the 12V battery and warns before it goes flat
detailed-desc=Logs the 12V battery charge while the car is on, shows drives and parked drops, and warns on the head unit when the battery runs low or drains fast. Read-only: it never sends anything to the car.
os=*.260507,*.260903
models=any
repository=https://github.com/zpoon/gen5w-BatteryWatchdog
postinstall=scripts/post.sh

[app.0]
kind=apk
path=app/batterywatchdog.apk
package=com.nemesis.batterywatchdog
component=com.nemesis.batterywatchdog/.MainActivity

[service.0]
name=watch
kind=sh
path=svc/watchdog.sh
uid=root
mode=restart
