[nemesis]
version=1.2
id=battery.watchdog
name=Battery Watchdog
types=application,service
postinstall=scripts/post.sh

[app.0]
kind=apk
path=app/batterywatchdog.apk
package=com.nemesis.batterywatchdog
component=com.nemesis.batterywatchdog/.MainActivity

[service.0]
name=monitor
kind=sh
path=svc/watchdog.sh
uid=root
mode=restart
