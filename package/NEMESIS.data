[nemesis]
version=1.2
id=lvbatt.monitor
name=12V Battery Monitor
types=application,service
postinstall=scripts/post.sh

[app.0]
kind=apk
path=app/lvbatt.apk
package=com.nemesis.lvbatt
component=com.nemesis.lvbatt/.MainActivity

[service.0]
name=monitor
kind=sh
path=svc/lvbatt.sh
uid=root
mode=background
