<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nemesis.batterywatchdog"
    android:versionCode="1"
    android:versionName="0.5.0">
  <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />
  <application
      android:label="Battery Watchdog"
      android:icon="@drawable/ic_launcher"
      android:allowBackup="false">
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:label="Battery Watchdog">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.DEFAULT" />
        <!-- LAUNCHER: NEMESIS Manager's home grid lists apps with a launcher entry -->
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <!-- page in the right-hand split-screen panel (HMG-API: hmgapi-mod/mod.json provides.panel) -->
    <receiver android:name=".PanelWidget" android:label="12V battery" android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="com.nemesis.batterywatchdog.PANEL_REFRESH" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/panel_widget" />
    </receiver>
  </application>
</manifest>
