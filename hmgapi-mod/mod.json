{
  "id": "battery-watchdog",
  "name": "Battery Watchdog",
  "version": "0.7.0",
  "hmgapi": ">=1.0.0",
  "authors": ["zpoon"],
  "license": "MIT",
  "repo": "https://github.com/zpoon/gen5w-BatteryWatchdog",
  "description": "Keeps an eye on the 12V battery: logs its charge on every drive, shows drives and parked drops, and warns on the car's screen when it runs low or drains fast. Read-only: it never sends anything to the car.",
  "live": true,
  "apps": [
    { "apk": "app/batterywatchdog.apk", "package": "com.nemesis.batterywatchdog" }
  ],
  "services": [
    { "name": "watch", "script": "svc/watchdog.sh", "user": "app", "start": "android", "restart": true }
  ],
  "vehicle": {
    "read": ["battery12v.soc", "hv.soc", "hv.health", "hv.ready", "charging", "outside_temp"]
  },
  "usb": ["BatteryWatchdog"],
  "provides": {
    "panel": [{"title": "12V battery", "widget": "com.nemesis.batterywatchdog/.PanelWidget"}],
    "launcher": [
      { "package": "com.nemesis.batterywatchdog", "class": "com.nemesis.batterywatchdog.MainActivity", "title": "Battery Watchdog",
                  "icon": "icons/icon.png", "icon_night": "icons/icon_night.png",
                  "icon_disabled": "icons/icon_disabled.png", "icon_disabled_night": "icons/icon_disabled_night.png" }
    ]
  }
}
